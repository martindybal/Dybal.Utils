<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--To inherit the global NuGet package sources remove the <clear/> line below -->
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <add key="dotnet core eng" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-tools/nuget/v3/index.json" />
  </packageSources>
  <!--
    Package source mapping (required with Central Package Management once more than
    one source is configured). Everything comes from nuget.org; the Roslyn testing
    packages (only their CI beta builds) additionally resolve from the dnceng feed.
  -->
  <packageSourceMapping>
    <packageSource key="nuget">
      <package pattern="*" />
      <package pattern="Microsoft.CodeAnalysis.*" />
    </packageSource>
    <packageSource key="dotnet core eng">
      <package pattern="Microsoft.CodeAnalysis.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
